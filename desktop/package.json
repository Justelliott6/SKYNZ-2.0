{
  "name": "skynz-desktop",
  "version": "3.3.0",
  "private": true,
  "description": "SKYNZ ASUS Windows desktop test shell",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "site.skynz.desktop",
    "productName": "SKYNZ 3.3",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "package.json",
      "../frontend/build/**/*"
    ],
    "extraResources": [
      {
        "from": "../frontend/build",
        "to": "web"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
