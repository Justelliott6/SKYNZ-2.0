# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/skynz

# Server
PORT=3001
NODE_ENV=development

# JWT
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Streaming APIs
SPOTIFY_API_KEY=YOUR_SPOTIFY_KEY_HERE
YOUTUBE_API_KEY=YOUR_YOUTUBE_KEY_HERE
TWITCH_API_KEY=YOUR_TWITCH_KEY_HERE
INSTAGRAM_API_KEY=YOUR_INSTAGRAM_KEY_HERE
TIKTOK_API_KEY=YOUR_TIKTOK_KEY_HERE
RESTREAM_API_KEY=YOUR_RESTREAM_KEY_HERE

# Solana
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_PRIVATE_KEY=YOUR_SOLANA_PRIVATE_KEY_HERE

# AWS (if using S3 for uploads)
AWS_ACCESS_KEY_ID=YOUR_AWS_KEY_HERE
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_HERE
AWS_REGION=us-east-1
AWS_S3_BUCKET=skynz-uploads
